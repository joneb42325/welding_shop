<!doctype html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>404 — Сторінку не знайдено | Wolfram Shop</title>
    <meta name="robots" content="noindex, follow">

    <link rel="icon" type="image/webp" href="/images/logo.webp">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>
    <link rel="dns-prefetch" href="https://res.cloudinary.com">
</head>
<body>
<%- include('../partials/header') %>

<main class="main">
    <%- include('../partials/sidebar') %>

    <div class="content about-page">
        <section class="about-hero error-404-hero">
            <div class="error-404-code">404</div>
            <h1><%= typeof message !== 'undefined' ? message : 'Сторінку не знайдено' %></h1>
            <p>
                Можливо, товар було знято з продажу, посилання застаріло або в адресі є помилка.
                Оберіть потрібну категорію в каталозі, скористайтеся пошуком або напишіть нам — допоможемо підібрати аналог.
            </p>
            <div class="search-cta-buttons" style="margin-top: 25px;">
                <a href="/" class="cta-btn phone-btn">Перейти до каталогу</a>
                <a href="https://t.me/+380634383823" target="_blank" rel="noopener" class="cta-btn tg-btn">Запитати в Telegram</a>
            </div>
        </section>
    </div>
</main>

<%- include('../partials/footer') %>

<script type="module" src="/js/layout-events.js"></script>
<script type="module" src="/js/script.js"></script>
