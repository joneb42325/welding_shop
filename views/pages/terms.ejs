<!doctype html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Публічний договір (оферта) та Політика конфіденційності | Wolfram Shop</title>
    <meta name="description" content="Публічний договір купівлі-продажу зварювальних матеріалів, умови доставки, оплати, повернення товару та Політика конфіденційності інтернет-магазину Wolfram Shop.">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://wolfram-shop.com.ua/terms.html">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Wolfram Shop">
    <meta property="og:title" content="Публічний договір (оферта) та Політика конфіденційності — Wolfram Shop">
    <meta property="og:description" content="Офіційні умови замовлення, оплати, доставки, обміну та обробки персональних даних в інтернет-магазині Wolfram Shop.">
    <meta property="og:url" content="https://wolfram-shop.com.ua/terms.html">
    <meta property="og:image" content="https://wolfram-shop.com.ua/images/logo.webp">

    <link rel="icon" type="image/webp" href="/images/logo.webp">
