<aside class="sidebar">
    <div class="catalog">
        <h2>🗂️ Категорії</h2>
        <ul id="catalog-list">
            <% if (locals.categories) { %>
                <% categories.forEach(cat => { %>
                    <% const isActive = Number(locals.activeCategoryId) === Number(cat.id); %>
                    <li>
                        <a href="/category/<%= cat.slug %>-<%= cat.id %>"
                           class="<%= isActive ? 'active' : '' %>">
                            <%= cat.name %>
                        </a>
                    </li>
                <% }); %>
            <% } %>
        </ul>
    </div>
</aside>